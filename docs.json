{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "RankSpot",
  "colors": {
    "primary": "#2563EB",
    "light": "#EBF2FF",
    "dark": "#2563EB"
  },
  "favicon": {
    "light": "/images/logo.png",
    "dark": "/images/logo.png"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Blog",
          "href": "https://www.rankspot.ai/blog",
          "icon": "newspaper"
        }
      ]
    },
    "groups": [
      {
        "group": "Introduction",
        "pages": [
          "index"
        ]
      },
      {
        "group": "MCP Server",
        "pages": [
          "mcp-server"
        ]
      },
      {
        "group": "API Endpoints",
        "openapi": "https://api.rankspot.ai/openapi.json",
        "expanded": true
      }
    ]
  },
  "logo": {
    "light": "/images/logo.png",
    "dark": "/images/logo.png"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Generate API key",
      "href": "https://app.rankspot.ai/"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "api": {
    "params": {
      "expanded": "all"
    },
    "url": "full",
    "playground": {
      "display": "interactive"
    }
  },
  "description": "RankSpot API and MCP server docs: keyword research, competitor and backlink analysis, AI visibility tracking, and article generation for your RankSpot workspace.",
  "redirects": [
    {
      "source": "/mcp",
      "destination": "/mcp-server"
    }
  ]
}
