{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "RankSpot",
  "colors": {
    "primary": "#2563EB",
    "light": "#EBF2FF",
    "dark": "#2563EB"
  },
  "favicon": {
    "light": "/images/logo.png",
    "dark": "/images/logo.png"
  },
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Blog",
          "href": "https://www.rankspot.ai/blog",
          "icon": "newspaper"
        }
      ]
    },
    "groups": [
      {
        "group": "Introduction",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "API Endpoints",
        "openapi": "https://api.rankspot.ai/docs-json",
        "expanded": true
      }
    ]
  },
  "logo": {
    "light": "/images/logo.png",
    "dark": "/images/logo.png"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "api": {
    "params": {
      "expanded": "all"
    },
    "url": "full"
  }
}
